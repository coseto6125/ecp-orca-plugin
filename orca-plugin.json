{
  "manifestVersion": 1,
  "id": "ecp",
  "publisher": "coseto6125",
  "name": "ECP Code Graph",
  "version": "0.1.2",
  "description": "Keeps the ecp symbol graph warm for every worktree, and puts index / impact / summary one click away.",
  "author": {
    "name": "coseto6125",
    "url": "https://github.com/coseto6125"
  },
  "repository": "https://github.com/coseto6125/ecp-orca-plugin",
  "engines": {
    "orca": ">=1.4.0"
  },
  "pluginApi": 1,
  "main": "worker/main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "console",
        "title": "ECP",
        "entry": "panel/index.html"
      }
    ],
    "commands": [
      {
        "id": "index-worktree",
        "title": "ECP: Index this worktree",
        "context": "worktree"
      },
      {
        "id": "impact-baseline",
        "title": "ECP: Impact vs base branch",
        "context": "worktree"
      },
      {
        "id": "summary",
        "title": "ECP: Index health",
        "context": "worktree"
      }
    ],
    "events": [
      {
        "on": "worktree.created"
      },
      {
        "on": "worktree.removed"
      }
    ],
    "keybindings": [
      {
        "command": "index-worktree",
        "key": "Mod+Alt+E",
        "when": "worktree"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "notifications:show"
    },
    {
      "kind": "storage"
    },
    {
      "kind": "events:subscribe"
    }
  ]
}
